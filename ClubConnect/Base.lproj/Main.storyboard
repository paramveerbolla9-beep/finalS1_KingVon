                            <constraint firstItem="ROLE-SEGMENT-001" firstAttribute="leading" secondItem="WELCOME-SAFE-001" secondAttribute="leading" constant="32" id="C-ROLE-LEADING"/>
                            <constraint firstItem="ROLE-SEGMENT-001" firstAttribute="top" secondItem="REMINDER-LABEL-001" secondAttribute="bottom" constant="18" id="C-ROLE-TOP"/>
                            <constraint firstItem="WELCOME-SAFE-001" firstAttribute="trailing" secondItem="ROLE-SEGMENT-001" secondAttribute="trailing" constant="32" id="C-ROLE-TRAILING"/>
                            <constraint firstItem="SUBTITLE-LABEL-001" firstAttribute="centerX" secondItem="WELCOME-SAFE-001" secondAttribute="centerX" id="C-SUBTITLE-CENTER"/>
                            <constraint firstItem="SUBTITLE-LABEL-001" firstAttribute="top" secondItem="TITLE-LABEL-001" secondAttribute="bottom" constant="8" id="C-SUBTITLE-TOP"/>
                            <constraint firstItem="REMINDER-SWITCH-001" firstAttribute="centerY" secondItem="REMINDER-LABEL-001" secondAttribute="centerY" id="C-SWITCH-CENTER-Y"/>
                            <constraint firstItem="WELCOME-SAFE-001" firstAttribute="trailing" secondItem="REMINDER-SWITCH-001" secondAttribute="trailing" constant="32" id="C-SWITCH-TRAILING"/>
                            <constraint firstItem="NAV-TITLE-LABEL" firstAttribute="centerX" secondItem="WELCOME-SAFE-001" secondAttribute="centerX" id="C-TITLE-CENTER"/>
                            <constraint firstItem="NAV-TITLE-LABEL" firstAttribute="top" secondItem="WELCOME-SAFE-001" secondAttribute="top" constant="15" id="C-TITLE-TOP"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="Club Connect" id="WELCOME-NAVITEM"/>
                    <connections>
