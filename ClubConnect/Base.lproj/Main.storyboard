                <placeholder placeholderIdentifier="IBFirstResponder" id="NAV-FIRST-001" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-650" y="0.0"/>
        </scene>
        <!--Club Connect-->
        <scene sceneID="WELCOME-SCENE-001">
